[Unit]
Description=BeoSound5c Visualizer feed (audio measurements for the VISUALIZER view)
After=network-online.target sound.target
Wants=network-online.target
OnFailure=beo-notify-failure@%n.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__HOME__/beosound5c/services
Environment=PYTHONUNBUFFERED=1
# Needs this user's PipeWire session: it reads beo_tone_sink's monitor
# with pw-record.
Environment=XDG_RUNTIME_DIR=/run/user/__UID__
ExecStart=/usr/bin/python3 __HOME__/beosound5c/services/visualizer.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
